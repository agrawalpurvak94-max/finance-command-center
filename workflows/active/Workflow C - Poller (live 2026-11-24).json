      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "getAll",
        "filters": {
          "labelIds": ["INBOX"],
          "q": "-has:attachment newer_than:14d -label:FCC-Needs-Review"
        }
      },
      "id": "e93241a0-897c-468a-949a-c38644c01c9d",
      "name": "List Inbox Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [272, 0],
      "webhookId": "e282a1ab-41a4-48a7-9c28-586082c220be",
      "credentials": { "gmailOAuth2": { "id": "TfVSEuuOO1bKoPOt", "name": "Gmail account 3" } }
    },
    {
      "parameters": {
        "jsCode": "// Retry sweep: every email still in the Inbox is either brand new or a previous attempt failed.\n// - attempt at most once per 5 minutes (a slow statement run may still be in flight)\n// - give up after 3 attempts: tag \"FCC Needs Review\" so it stops being retried and a human looks at it\nconst sd = $getWorkflowStaticData('global');\nsd.attempts = sd.attempts || {};\nconst now = Date.now(), COOLDOWN = 5 * 60 * 1000, MAX = 3;\nconst seen = new Set();\nconst out = [];\nfor (const it of $input.all()) {\n  const id = it.json.id; seen.add(id);\n  const a = sd.attempts[id] || { n: 0, last: 0 };\n  if (a.n >= MAX) { out.push({ json: { id, action: 'give_up', attempts: a.n } }); continue; }\n  if (now - a.last < COOLDOWN) continue;\n  a.n += 1; a.last = now; sd.attempts[id] = a;\n  out.push({ json: { id, action: 'process', attempts: a.n } });\n}\nfor (const id of Object.keys(sd.attempts)) if (!seen.has(id)) delete sd.attempts[id];\nreturn out;"
      },
      "id": "8f2559e9-4278-4d77-bd68-9255a6be3fc2",
      "name": "Pick Due Emails (retry limit)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [528, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d6af56cb-529c-4538-9dd6-4b6bfc1ed175",
              "leftValue": "={{ $json.action }}",
              "rightValue": "process",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "bfd70318-5491-4938-80f5-7cdff2816dd4",
      "name": "Process or Give Up",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [656, 128]
    },
    {
      "parameters": {
        "url": "http://localhost:5678/webhook/fcc-c-ingest",
