      "typeVersion": 2.1,
      "position": [1040, 100],
      "credentials": { "gmailOAuth2": { "id": "TfVSEuuOO1bKoPOt", "name": "Gmail account 3" } },
      "webhookId": "c4c9a3a5-ac14-4b8e-b251-bc1e28a498f7"
    },
    {
      "id": "loop-one-at-a-time",
      "name": "Loop One Email At A Time",
      "type": "n8n-nodes-base.splitInBatches",
