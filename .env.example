# Supabase (client-safe values only — anon key, RLS enforces access)
# Never put the service role key in a VITE_-prefixed variable; it would be
# inlined into the client bundle. Service-role operations belong in
# Supabase Edge Functions, configured as Edge Function secrets instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development-only session bootstrap (src/lib/supabaseAuth.ts). If both are
# set, the app silently signs in as this user on boot so RLS-scoped reads/
# writes work without a login UI (Module 12A's contract forbids adding new
# pages). A real deployment either leaves these blank (and adds a proper
# auth flow when that becomes in scope) or points them at its own user —
# nothing in the app code assumes this specific project/user.
VITE_SUPABASE_DEV_EMAIL=
VITE_SUPABASE_DEV_PASSWORD=
