    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 2 }] } },
      "id": "c380dfef-9379-4664-9cf2-9531c4b0a20b",
      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "simple": true,
        "filters": {
          "labelIds": ["INBOX"],
          "q": "has:attachment filename:pdf newer_than:14d -label:FCC-Needs-Review"
        }
      },
      "id": "467ffa4e-d7b2-409a-a0de-304acef0a31d",
      "name": "List Inbox Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [260, 0],
      "credentials": { "gmailOAuth2": { "id": "TfVSEuuOO1bKoPOt", "name": "Gmail account 3" } },
      "webhookId": "f9d15021-e2c2-4549-a3e4-7b3fa3984a8f"
    },
    {
      "parameters": {
        "jsCode": "// Retry sweep: every email still in the Inbox is either brand new or a previous attempt failed.\n// - attempt at most once per 5 minutes (a slow statement run may still be in flight)\n// - give up after 3 attempts: tag \"FCC Needs Review\" so it stops being retried and a human looks at it\nconst sd = $getWorkflowStaticData('global');\nsd.attempts = sd.attempts || {};\nconst now = Date.now(), COOLDOWN = 5 * 60 * 1000, MAX = 3;\nconst seen = new Set();\nconst out = [];\nfor (const it of $input.all()) {\n  const id = it.json.id; seen.add(id);\n  const a = sd.attempts[id] || { n: 0, last: 0 };\n  if (a.n >= MAX) { out.push({ json: { id, action: 'give_up', attempts: a.n } }); continue; }\n  if (now - a.last < COOLDOWN) continue;\n  a.n += 1; a.last = now; sd.attempts[id] = a;\n  out.push({ json: { id, action: 'process', attempts: a.n } });\n}\nfor (const id of Object.keys(sd.attempts)) if (!seen.has(id)) delete sd.attempts[id];\nreturn out;"
      },
      "id": "67a1eff1-6966-40c0-828a-04908a550577",
      "name": "Pick Due Emails (retry limit)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "823557c1-8c47-48c4-9aa4-cf9e0240c8ba",
              "leftValue": "={{ $json.action }}",
              "rightValue": "process",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c86954e9-a8b2-4365-9e81-8a0065b4f03a",
      "name": "Process or Give Up",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [780, 0]
    },
    {
      "parameters": {
        "url": "http://localhost:5678/webhook/fcc-d-ingest",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "id", "value": "={{ $json.id }}" }] },
        "options": { "timeout": 900000, "response": { "response": { "neverError": true } } }
      },
      "id": "7bd7334e-bf9c-4f77-a66b-2860f936a168",
      "name": "Run Ingest (one email per execution)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, -80]
    },
