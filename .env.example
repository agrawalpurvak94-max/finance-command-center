# Supabase (client-safe values only — anon key, RLS enforces access)
# Never put the service role key in a VITE_-prefixed variable; it would be
# inlined into the client bundle. Service-role operations belong in
# Supabase Edge Functions, configured as Edge Function secrets instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
